        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "((((((min by (instance, cn, issuer_cn, serial_no, san, file, namespace, secret, key, kubeconfig, name, type) (label_replace(({__name__=~\"ssl_(cert|file_cert|keystore_cert|kubernetes_cert|kubeconfig_cert)_not_after\", job=~\"$job\", instance=~\"$instance\", cn=~\"$cn\"} - time()) / 86400, \"san\", \"$1\", \"dnsnames\", \"^,(.*),$\"))) * on(instance) group_left(version) (ssl_tls_version_info{job=~\"$job\", instance=~\"$instance\"} == 1)) or on(instance, cn, issuer_cn, serial_no, san, file, namespace, secret, key, kubeconfig, name, type) (min by (instance, cn, issuer_cn, serial_no, san, file, namespace, secret, key, kubeconfig, name, type) (label_replace(({__name__=~\"ssl_(cert|file_cert|keystore_cert|kubernetes_cert|kubeconfig_cert)_not_after\", job=~\"$job\", instance=~\"$instance\", cn=~\"$cn\"} - time()) / 86400, \"san\", \"$1\", \"dnsnames\", \"^,(.*),$\"))))) * on(instance) group_left(ocsp) ((label_replace(({__name__=~\"ssl_ocsp_(response|responder)_status\", job=~\"$job\", instance=~\"$instance\"} == 0) * 0 + 1, \"ocsp\", \"Good\", \"__name__\", \".*\") or label_replace(({__name__=~\"ssl_ocsp_(response|responder)_status\", job=~\"$job\", instance=~\"$instance\"} == 1) * 0 + 1, \"ocsp\", \"Revoked\", \"__name__\", \".*\") or label_replace(({__name__=~\"ssl_ocsp_(response|responder)_status\", job=~\"$job\", instance=~\"$instance\"} == 2) * 0 + 1, \"ocsp\", \"Unknown\", \"__name__\", \".*\")))) or on(instance, cn, issuer_cn, serial_no, san, file, namespace, secret, key, kubeconfig, name, type, version) ((((min by (instance, cn, issuer_cn, serial_no, san, file, namespace, secret, key, kubeconfig, name, type) (label_replace(({__name__=~\"ssl_(cert|file_cert|keystore_cert|kubernetes_cert|kubeconfig_cert)_not_after\", job=~\"$job\", instance=~\"$instance\", cn=~\"$cn\"} - time()) / 86400, \"san\", \"$1\", \"dnsnames\", \"^,(.*),$\"))) * on(instance) group_left(version) (ssl_tls_version_info{job=~\"$job\", instance=~\"$instance\"} == 1)) or on(instance, cn, issuer_cn, serial_no, san, file, namespace, secret, key, kubeconfig, name, type) (min by (instance, cn, issuer_cn, serial_no, san, file, namespace, secret, key, kubeconfig, name, type) (label_replace(({__name__=~\"ssl_(cert|file_cert|keystore_cert|kubernetes_cert|kubeconfig_cert)_not_after\", job=~\"$job\", instance=~\"$instance\", cn=~\"$cn\"} - time()) / 86400, \"san\", \"$1\", \"dnsnames\", \"^,(.*),$\"))))))",
          "legendFormat": "__auto",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
